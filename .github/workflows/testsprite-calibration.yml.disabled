name: TestSprite calibration

on:
  workflow_dispatch:
    inputs:
      target_url:
        description: Deployment URL to test
        required: true
        type: string

permissions:
  contents: read

jobs:
  testsprite:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      TESTSPRITE_API_KEY: ${{ secrets.TESTSPRITE_API_KEY }}
      TESTSPRITE_PROJECT_ID: ${{ secrets.TESTSPRITE_PROJECT_ID }}
      TARGET_URL: ${{ inputs.target_url }}
    steps:
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm i -g @testsprite/testsprite-cli@0.15.0
      - run: testsprite ci run --help
      - id: run
        run: >
          testsprite --output json ci run
          --target-url "$TARGET_URL"
          --timeout 900
          --summary-file testsprite-summary.json
          > testsprite-output.json
      - if: always()
        uses: actions/upload-artifact@v4
        with:
          name: testsprite-json
          path: |
            testsprite-output.json
            testsprite-summary.json
          if-no-files-found: warn
