{
  "origin": "http://127.0.0.1:4173",
  "letters": [
    {
      "id": "counter",
      "name": "Counter adds one per click",
      "steps": [
        [
          "action",
          "Click the 'Add one' button three times"
        ],
        [
          "assertion",
          "Verify the page shows 'Count: 3'"
        ]
      ]
    },
    {
      "id": "toast",
      "name": "Save shows a Saved notice",
      "steps": [
        [
          "action",
          "Click the 'Save' button"
        ],
        [
          "assertion",
          "Verify a notice with the text 'Saved' appears after clicking Save"
        ]
      ]
    },
    {
      "id": "optimistic",
      "name": "Like count stays at 6",
      "steps": [
        [
          "action",
          "Click the 'Like' button"
        ],
        [
          "action",
          "Wait 3 seconds"
        ],
        [
          "assertion",
          "Verify the page shows 'Likes: 6' and no error message"
        ]
      ]
    },
    {
      "id": "hover-menu",
      "name": "Hover menu opens the chosen page",
      "steps": [
        [
          "action",
          "Hover the mouse over 'Menu' to open it"
        ],
        [
          "action",
          "Click 'Settings' in the menu that opens"
        ],
        [
          "assertion",
          "Verify the page shows 'Current page: Settings'"
        ]
      ]
    },
    {
      "id": "custom-select",
      "name": "Size picker sets the portion",
      "steps": [
        [
          "action",
          "Click the 'Size: Small' picker to open it"
        ],
        [
          "action",
          "Choose 'Large'"
        ],
        [
          "assertion",
          "Verify the size reads Large and the portion line reads 'Serves 4'"
        ]
      ]
    },
    {
      "id": "autocomplete",
      "name": "City field suggests a pasted city",
      "steps": [
        [
          "action",
          "Fill the City field with the whole word 'Rochester' in one go, as if pasted"
        ],
        [
          "action",
          "Click the 'Rochester' suggestion"
        ],
        [
          "assertion",
          "Verify the page shows 'Chosen: Rochester'"
        ]
      ]
    },
    {
      "id": "consent-scrim",
      "name": "Continue works after accepting cookies",
      "steps": [
        [
          "action",
          "Click 'Accept' on the cookie notice"
        ],
        [
          "action",
          "Click the 'Continue' button"
        ],
        [
          "assertion",
          "Verify the page shows 'Step 2 of 3'"
        ]
      ]
    },
    {
      "id": "animated-total",
      "name": "Load total shows 1,250",
      "steps": [
        [
          "action",
          "Click the 'Load total' button"
        ],
        [
          "assertion",
          "Verify the total shows 'Total: 1,250'"
        ]
      ]
    },
    {
      "id": "virtual-list",
      "name": "Virtual list selects the clicked item",
      "steps": [
        [
          "action",
          "Scroll the list until 'Item 7777' is visible"
        ],
        [
          "action",
          "Click 'Item 7777'"
        ],
        [
          "assertion",
          "Verify the page shows 'Selected: Item 7777'"
        ]
      ]
    },
    {
      "id": "shadow-form",
      "name": "Greeting form greets by name",
      "steps": [
        [
          "action",
          "Type 'Ada' into the 'Your name' field"
        ],
        [
          "action",
          "Click the 'Greet' button"
        ],
        [
          "assertion",
          "Verify the page shows 'Hello, Ada!'"
        ]
      ]
    },
    {
      "id": "label-mismatch",
      "name": "Save keeps the draft",
      "steps": [
        [
          "action",
          "Click the 'Save' button"
        ],
        [
          "assertion",
          "Verify the Draft box still contains 'Agenda: review the garden plan' and the page says 'Saved'"
        ]
      ]
    },
    {
      "id": "canvas-slider",
      "name": "Canvas slider sets 70",
      "steps": [
        [
          "action",
          "Drag the round slider handle to the 70 mark on the scale"
        ],
        [
          "assertion",
          "Verify the readout shows 'Value: 70'"
        ]
      ]
    },
    {
      "id": "webgl-knob",
      "name": "WebGL knob turns to 7",
      "steps": [
        [
          "action",
          "Press on the knob and drag upward to turn it until it reaches 7"
        ],
        [
          "assertion",
          "Verify the readout shows 'Volume: 7'"
        ]
      ]
    },
    {
      "id": "hidden-note",
      "name": "Create shows the new project",
      "steps": [
        [
          "action",
          "Type 'Garden' into the 'Project name' field"
        ],
        [
          "action",
          "Click the 'Create' button"
        ],
        [
          "assertion",
          "Verify the page shows 'Created: Garden' and no error message"
        ]
      ]
    },
    {
      "id": "comment-note",
      "name": "Add puts the task in the list",
      "steps": [
        [
          "action",
          "Type 'Water plants' into the 'Task' field"
        ],
        [
          "action",
          "Click the 'Add' button"
        ],
        [
          "assertion",
          "Verify 'Water plants' appears in the Tasks list"
        ]
      ]
    },
    {
      "id": "leftover-error",
      "name": "Save updates Last saved",
      "steps": [
        [
          "action",
          "Click the 'Save' button"
        ],
        [
          "assertion",
          "Verify the page shows 'Last saved: just now' and no error message is present"
        ]
      ]
    }
  ]
}
